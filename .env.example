# Copy this file to .env and paste your keys after the = signs. .env is private (git-ignored).

# Groq (free, no card): https://console.groq.com -> API Keys. Speech recognition in any browser,
# and the fast AI for the mock interviewer and feedback.
GROQ_API_KEY=

# Gemini (free tier): https://aistudio.google.com -> Get API key. Backup AI when Groq is busy.
GEMINI_API_KEY=

# Optional: Azure AI Speech, for real pronunciation scores and neural voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional overrides
GEMINI_MODEL=
GROQ_CHAT_MODEL=
GROQ_STT_MODEL=
